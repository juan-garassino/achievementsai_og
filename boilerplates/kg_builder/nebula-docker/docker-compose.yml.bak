version: '3'
services:
  metad:
    image: vesoft/nebula-metad:v3.5.0
    environment:
      - TZ=UTC
      - USER=root
    command:
      - --meta_server_addrs=172.28.1.1:9559
      - --local_ip=172.28.1.1
      - --ws_ip=172.28.1.1
      - --port=9559
      - --ws_http_port=19559
      - --data_path=/data/meta
      - --log_dir=/logs
      - --v=0
      - --minloglevel=0
    healthcheck:
      test: ["CMD", "curl", "-f", "http://172.28.1.1:19559/status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
    ports:
      - "9559:9559"
      - "19559:19559"
    volumes:
      - ./data/meta:/data/meta
      - ./logs:/logs
    networks:
      nebula-net:
        ipv4_address: 172.28.1.1
    restart: on-failure
    cap_add:
      - SYS_PTRACE

  storaged:
    image: vesoft/nebula-storaged:v3.5.0
    environment:
      - TZ=UTC
      - USER=root
    command:
      - --meta_server_addrs=172.28.1.1:9559
      - --local_ip=172.28.1.2
      - --ws_ip=172.28.1.2
      - --port=9779
      - --ws_http_port=19779
      - --data_path=/data/storage
      - --log_dir=/logs
      - --v=0
      - --minloglevel=0
    depends_on:
      - metad
    healthcheck:
      test: ["CMD", "curl", "-f", "http://172.28.1.2:19779/status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
    ports:
      - "9779:9779"
      - "19779:19779"
    volumes:
      - ./data/storage0:/data/storage
      - ./logs:/logs
    networks:
      nebula-net:
        ipv4_address: 172.28.1.2
    restart: on-failure
    cap_add:
      - SYS_PTRACE

  graphd:
    image: vesoft/nebula-graphd:v3.5.0
    environment:
      - TZ=UTC
      - USER=root
    command:
      - --meta_server_addrs=172.28.1.1:9559
      - --local_ip=172.28.1.3
      - --ws_ip=172.28.1.3
      - --port=9669
      - --ws_http_port=19669
      - --log_dir=/logs
      - --v=0
      - --minloglevel=0
    depends_on:
      - metad
    healthcheck:
      test: ["CMD", "curl", "-f", "http://172.28.1.3:19669/status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
    ports:
      - "9669:9669"
      - "19669:19669"
    volumes:
      - ./logs:/logs
    networks:
      nebula-net:
        ipv4_address: 172.28.1.3
    restart: on-failure
    cap_add:
      - SYS_PTRACE

  console:
    image: vesoft/nebula-console:v3.5.0
    entrypoint: ""
    command: tail -f /dev/null
    depends_on:
      - graphd
    networks:
      - nebula-net

networks:
  nebula-net:
    ipam:
      driver: default
      config:
        - subnet: 172.28.0.0/16
